rules_version = '2';
// One top-level collection per mini app. Everything not matched below is closed. Nobody writes from the browser:
// every change goes through a Cloud Function (functions/index.js, functions/parties-api.js).
//
// users/{uid}: the invite list, one record per person: { email, name, gender, role, staffPartyId, createdAt, createdBy, updatedAt }.
//   - A signed-in person can read only their own record; owners can read (and list) every record.
// loginCodes/{sha256(email)}: sign-in code hashes and send history. Only Cloud Functions touch it (closed below).
// parties/{partyId}: the parties mini app.
//   - Owners read everything in it.
//   - Staff read the one party they're assigned to (users/{uid}.staffPartyId): the party, its guest list and requests.
//     Not the hidden location (private/details), other parties or People.
//   - A guest can read the party only once it is published AND has a custom page, and only their own guest record
//     and the invite requests they made. Never the guest list, the hidden location (private/details) or link tokens.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function hasRecord() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function isOwner() { return hasRecord() && me().role == "owner"; }
    function isManager(partyId) { return hasRecord() && (me().role == "owner" || (me().role == "staff" && me().staffPartyId == partyId)); }

    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isOwner());
      allow list: if isOwner();
      allow write: if false;
    }

    match /parties/{partyId} {
      allow get: if isManager(partyId) || (signedIn()
        && resource.data.published == true
        && resource.data.pageSlug is string
        && exists(/databases/$(database)/documents/parties/$(partyId)/guests/$(request.auth.uid)));
      allow list: if isOwner();

      match /guests/{uid} {
        allow get: if isManager(partyId) || (signedIn() && request.auth.uid == uid);
        allow list: if isManager(partyId);
      }
      match /requests/{requestId} {
        allow read: if isManager(partyId) || (signedIn() && resource.data.by == request.auth.uid);
      }
      match /private/{docId} {
        allow read: if isOwner();
      }
      // tokens/{sha256}: invite link hashes, functions only (closed by the catch-all).
    }

    // "Which parties am I on?": a collection-group query on guests where uid == me.
    match /{path=**}/guests/{uid} {
      allow list: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
