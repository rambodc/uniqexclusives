rules_version = '2';
// One top-level collection per mini app. Everything not matched below is closed.
//
// users/{uid}: the invite list, one record per person: { email, name, role, createdAt, createdBy, updatedAt }.
//   - A signed-in person can read only their own record; owners can read (and list) every record.
//   - Nobody writes from the browser: owners add and remove people through the createUser / removeUser functions.
// loginCodes/{sha256(email)}: sign-in code hashes and send history. Only Cloud Functions touch it (closed below).
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "owner";
    }

    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isOwner());
      allow list: if isOwner();
      allow write: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
